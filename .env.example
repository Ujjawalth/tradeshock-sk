# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for headline->scenario and plan explanation
ANTHROPIC_MODEL=claude-opus-5-5
# Set to 0 to disable server-side refusal fallbacks (only some models support them)
ANTHROPIC_USE_FALLBACKS=1
# Max AI requests per IP per minute
AI_RATE_LIMIT_PER_MIN=10
# Admin password that unlocks live AI (12+ characters). Leave empty to keep AI open (local dev).
AI_ACCESS_PASSWORD=
# Max AI calls per day per server process (protects your API credit); over it, offline mode
AI_DAILY_CALL_LIMIT=300
